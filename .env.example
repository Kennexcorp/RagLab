# RAGLab environment variables
# Copy this file to .env and adjust. Every value below is optional; the defaults
# shown are the ones in raglab/config.py.

# --- LLM ---------------------------------------------------------------------
# Options: ollama, openai, anthropic
LLM_PROVIDER=ollama
# Required only when LLM_PROVIDER is openai / anthropic respectively
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=llama3.2
# Where to reach Ollama. Inside a container this must not be localhost; use
# http://host.docker.internal:11434 (Docker Desktop) or a compose service name.
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# --- Embeddings and vector store ---------------------------------------------
# Any sentence-transformers model name
EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLECTION_NAME=documents

# --- Chunking ----------------------------------------------------------------
# Options: semantic, fixed, markdown, markdown-headers, token, python, latex,
#          spacy, nltk, semantic-embedding
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# --- Retrieval ---------------------------------------------------------------
# Options: semantic, hybrid, mmr, multi-query, reranking, hyde, self-query,
#          parent-child
RETRIEVAL_STRATEGY=semantic
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
# Used by the reranking strategy
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Used by the parent-child strategy
PARENT_CHUNK_SIZE=1024

# --- Hybrid search (semantic + BM25) -----------------------------------------
USE_HYBRID_SEARCH=true
SEMANTIC_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# --- System ------------------------------------------------------------------
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
MAX_CONTEXT_LENGTH=4000
# Overrides the assistant's system prompt
# SYSTEM_PROMPT=
