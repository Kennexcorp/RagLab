# RAG System Environment Variables
# Copy this file to .env and fill in your actual values

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, ollama
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-3.5-turbo  # or gpt-4, claude-3-sonnet, etc.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Embedding Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2  # sentence-transformers model
EMBEDDING_DIMENSION=384
USE_OPENAI_EMBEDDINGS=false  # Set to true to use OpenAI embeddings instead

# Vector Store Configuration
VECTOR_STORE_TYPE=chromadb  # Options: chromadb, faiss
COLLECTION_NAME=dashboard_data

# Chunking Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
CHUNKING_STRATEGY=semantic  # Options: semantic, fixed

# Retrieval Configuration
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
USE_RERANKING=false

# Hybrid Search Configuration
USE_HYBRID_SEARCH=true
SEMANTIC_WEIGHT=0.7  # 70% weight for semantic search
KEYWORD_WEIGHT=0.3   # 30% weight for keyword search
BM25_K1=1.5          # BM25 term frequency saturation
BM25_B=0.75          # BM25 length normalization

# System Configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
MAX_CONTEXT_LENGTH=4000
